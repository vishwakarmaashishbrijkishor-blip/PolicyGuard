{
  "name": "policyguard",
  "version": "0.1.0",
  "description": "Evidence-linked, policy-as-code review engine for AI-assisted software development.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "policyguard": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "policies",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "code-review",
    "policy-as-code",
    "static-analysis",
    "typescript",
    "ai-assisted-development"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "evaluate": "vitest run --config vitest.eval.config.ts",
    "demo": "node examples/demo/run-demo.mjs"
  },
  "dependencies": {
    "cli-table3": "^0.6.5",
    "commander": "^15.1.0",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "simple-git": "^4.0.2",
    "ts-morph": "^28.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/picomatch": "^4.0.3",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
